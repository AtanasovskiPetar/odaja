# Backend server
PORT=8787
CORS_ORIGIN=http://localhost:5173

# Postgres (used by compose.yml, drizzle-kit, and backend)
POSTGRES_USER=odaja
POSTGRES_PASSWORD=odaja_dev_password
POSTGRES_DB=odaja
POSTGRES_PORT=5432
DATABASE_URL=postgres://odaja:odaja_dev_password@localhost:5432/odaja

# Auth (generate a 32+ char random secret for production)
BETTER_AUTH_SECRET=dev-only-change-me-to-a-long-random-secret-string
BETTER_AUTH_URL=http://localhost:8787

# S3-compatible object storage (used by compose.yml ferdzo/fs and backend)
S3_PORT=2600
S3_ENDPOINT=http://localhost:2600
# Optional public endpoint for browser presigned URLs (e.g. R2 custom domain or localhost when backend runs in Docker)
S3_PUBLIC_ENDPOINT=http://localhost:2600
S3_REGION=us-east-1
S3_BUCKET=odaja
S3_ACCESS_KEY_ID=odaja_access_key
S3_SECRET_ACCESS_KEY=odaja_secret_key

# Frontend (optional: set to enable cloud mode in Vite by default)
# VITE_CLOUD_API_URL=http://localhost:8787
