# Backend server
PORT=8787
CORS_ORIGIN=http://localhost:5173

# Postgres (used by compose.yml, drizzle-kit, and backend)
POSTGRES_USER=odaja
POSTGRES_PASSWORD=odaja_dev_password
POSTGRES_DB=odaja
POSTGRES_PORT=5432
DATABASE_URL=postgres://odaja:odaja_dev_password@localhost:5432/odaja

# Auth (generate a 32+ char random secret for production)
BETTER_AUTH_SECRET=dev-only-change-me-to-a-long-random-secret-string
BETTER_AUTH_URL=http://localhost:8787
# Optional sign-in methods (email and password always work):
# Google / GitHub, each on when both values are set
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Email (sign-in links, password resets, verification) through Resend. Without
# it, in development the links are written to the backend's log.
# RESEND_API_KEY=
# EMAIL_FROM=Odaja <hello@example.com>
# Refuse passwords known from data breaches (asks the Have I Been Pwned API)
# AUTH_CHECK_LEAKED_PASSWORDS=true

# History: how many days of versions to keep (named ones always stay; unset = all, thinned)
# VERSION_KEEP_DAYS=365

# S3-compatible object storage (used by compose.yml ferdzo/fs and backend)
S3_PORT=2600
S3_ENDPOINT=http://localhost:2600
# Optional public endpoint for browser presigned URLs (e.g. R2 custom domain or localhost when backend runs in Docker)
S3_PUBLIC_ENDPOINT=http://localhost:2600
S3_REGION=us-east-1
S3_BUCKET=odaja
S3_ACCESS_KEY_ID=odaja_access_key
S3_SECRET_ACCESS_KEY=odaja_secret_key

# Frontend: the cloud server's address. With it set, the app offers signing in
# and lists the account's homes next to local ones; without it, no cloud.
VITE_CLOUD_API_URL=http://localhost:8787
