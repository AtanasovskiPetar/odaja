# Backend server
PORT=8787
CORS_ORIGIN=http://localhost:5173

# Postgres (used by compose.yml, drizzle-kit, and backend)
POSTGRES_USER=odaja
POSTGRES_PASSWORD=odaja_dev_password
POSTGRES_DB=odaja
POSTGRES_PORT=5432
DATABASE_URL=postgres://odaja:odaja_dev_password@localhost:5432/odaja

# Auth (generate a 32+ char random secret for production)
BETTER_AUTH_SECRET=dev-only-change-me-to-a-long-random-secret-string
BETTER_AUTH_URL=http://localhost:8787
# Optional sign-in methods (email and password always work):
# Google / GitHub, each on when both values are set
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Email (sign-in links, password resets, verification) through Resend. Without
# it, in development the links are written to the backend's log.
# RESEND_API_KEY=
# EMAIL_FROM=Odaja <hello@example.com>
# Refuse passwords known from data breaches (asks the Have I Been Pwned API)
# AUTH_CHECK_LEAKED_PASSWORDS=true
# Cloudflare Turnstile on sign-up, sign-in links and password resets (both
# values). Cloudflare's test keys, which always pass, for trying it locally:
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# AI on the server's key (docs/cloud-plan.md, "AI"): on when both
# ANTHROPIC_API_KEY and AI_MODELS are set; otherwise people use their own keys
# in the page as before. Prices are the provider's, in USD per million tokens
# (cacheWrite: 5-minute cache writes); `rate` charges more credits per credit of
# cost for a model; `effort` and `fallback` (the API's refusal fallback) are optional.
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://gateway.ai.cloudflare.com/v1/<account>/<gateway>/anthropic
# AI_MODELS=[{"id":"standard","name":"Odaja AI","model":"claude-sonnet-5-5","price":{"input":2,"output":10,"cacheRead":0.1,"cacheWrite":2.5},"effort":"medium","fallback":true,"default":true},{"id":"quick","name":"Odaja AI Quick","model":"claude-haiku-5-5","price":{"input":0.1,"output":0.5,"cacheRead":0.01,"cacheWrite":0.125}},{"id":"best","name":"Odaja AI Best","model":"claude-opus-5-5","price":{"input":4,"output":20,"cacheRead":0.2,"cacheWrite":5},"rate":1.5,"effort":"high","fallback":true}]
# Credits per dollar of model cost (default 100: a credit is a cent of cost).
# AI_CREDITS_PER_USD=100
# Credits each account gets once, and is topped up to every month (default 0).
# AI_STARTER_CREDITS=50
# AI_MONTHLY_CREDITS=0
# The most credits an account can spend in a month, whatever its balance.
# AI_MONTHLY_CEILING_CREDITS=2000
# Only for confirmed email addresses (default: when email is set up).
# AI_REQUIRE_VERIFIED_EMAIL=true
# Per reply and per account (defaults shown).
# AI_MAX_STEPS=25
# AI_MAX_OUTPUT_TOKENS=16000
# AI_MAX_HISTORY_TOKENS=150000
# AI_REPLIES_PER_MINUTE=6
# AI_REPLIES_PER_DAY=200
# Where to buy more credits (shown when they run out); payments come later.
# AI_TOP_UP_URL=

# History: how many days of versions to keep (named ones always stay; unset = all, thinned)
# VERSION_KEEP_DAYS=365

# S3-compatible object storage (used by compose.yml ferdzo/fs and backend)
S3_PORT=2600
S3_ENDPOINT=http://localhost:2600
# Optional public endpoint for browser presigned URLs (e.g. R2 custom domain or localhost when backend runs in Docker)
S3_PUBLIC_ENDPOINT=http://localhost:2600
S3_REGION=us-east-1
S3_BUCKET=odaja
S3_ACCESS_KEY_ID=odaja_access_key
S3_SECRET_ACCESS_KEY=odaja_secret_key

# Frontend: the cloud server's address. With it set, the app offers signing in
# and lists the account's homes next to local ones; without it, no cloud.
VITE_CLOUD_API_URL=http://localhost:8787
